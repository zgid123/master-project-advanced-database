{
  "name": "solvit",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "clear": "pnpm -r exec rimraf node_modules dist .turbo lib && pnpm rimraf node_modules .turbo",
    "setup:windows": "powershell -ExecutionPolicy Bypass -File scripts/setup-windows.ps1",
    "sync:workspace": "node scripts/sync-workspace-node-modules.mjs",
    "dev": "node scripts/sync-workspace-node-modules.mjs && turbo run dev --parallel --no-cache",
    "serve": "node scripts/sync-workspace-node-modules.mjs && turbo run serve --parallel --no-cache",
    "build": "node scripts/sync-workspace-node-modules.mjs && turbo run build",
    "docs:api": "node scripts/sync-workspace-node-modules.mjs && node scripts/generate-api-docs.mjs",
    "update-packages": "pnpm update -i -r --latest",
    "test": "node scripts/sync-workspace-node-modules.mjs && vitest run --coverage",
    "server:dev": "node scripts/sync-workspace-node-modules.mjs && turbo run dev --filter=\"api-gateway\" --filter=\"auth\" --filter=\"notifications\" --filter=\"job-service\" --filter=\"qna\" --filter=\"recsys\" --parallel --no-cache"
  },
  "packageManager": "pnpm@10.33.4",
  "devDependencies": {
    "@alphacifer/biome": "0.0.11",
    "@alphacifer/tsconfig": "0.0.15",
    "@biomejs/biome": "2.4.14",
    "@types/globals": "workspace:^",
    "@types/node": "25.6.0",
    "@vitest/coverage-istanbul": "4.1.5",
    "dotenv-cli": "11.0.0",
    "lefthook": "2.1.6",
    "rimraf": "6.1.3",
    "tsx": "4.21.0",
    "turbo": "2.9.9",
    "typescript": "6.0.3",
    "vite": "8.0.10",
    "vitest": "4.1.5"
  },
  "dependencies": {
    "@alphacifer/core-utils": "0.0.9",
    "arktype": "2.2.0",
    "detect-port": "2.1.0",
    "dotenv": "17.4.2",
    "tslib": "2.8.1"
  },
  "pnpm": {
    "overrides": {
      "fast-jwt": "6.2.4",
      "ioredis": "5.10.1"
    }
  }
}
