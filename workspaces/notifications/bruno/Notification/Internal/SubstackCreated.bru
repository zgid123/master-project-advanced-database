meta {
  name: Substack Created
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/internal/v1/notifications
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-internal-service-secret: {{internalServiceSecret}}
}

body:json {
  {
    "type": "substack.created",
    "userId": "{{userId}}",
    "data": {
      "substackId": "{{substackId}}",
      "substackName": "{{substackName}}",
      "substackSlug": "{{substackSlug}}"
    }
  }
}

script:post-response {
  const body = res.getBody();
  const data = typeof body === 'string' ? JSON.parse(body) : body;

  if (data?.data?.id) {
    bru.setEnvVar('notificationId', data.data.id);
  }
}
