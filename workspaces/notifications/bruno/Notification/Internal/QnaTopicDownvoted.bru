meta {
  name: QnA Topic Downvoted
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/internal/v1/notifications
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-internal-service-secret: {{internalServiceSecret}}
}

body:json {
  {
    "type": "qna.topic.downvoted",
    "userId": "{{userId}}",
    "data": {
      "actorUserId": "{{actorUserId}}",
      "topicId": "{{topicId}}",
      "topicTitle": "{{topicTitle}}"
    }
  }
}

script:post-response {
  const body = res.getBody();
  const data = typeof body === 'string' ? JSON.parse(body) : body;

  if (data?.data?.id) {
    bru.setEnvVar('notificationId', data.data.id);
  }
}
