meta {
  name: Auth Sign Up Welcome
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/internal/v1/notifications
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-internal-service-secret: {{internalServiceSecret}}
}

body:json {
  {
    "type": "auth.sign-up.welcome",
    "userId": "{{userId}}",
    "data": {
      "email": "user@example.com"
    }
  }
}

script:post-response {
  const body = res.getBody();
  const data = typeof body === 'string' ? JSON.parse(body) : body;

  if (data?.data?.id) {
    bru.setEnvVar('notificationId', data.data.id);
  }
}
