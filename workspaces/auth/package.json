{
  "name": "auth",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate:create": "dotenv -e .env -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env -- drizzle-kit migrate",
    "db:migrate:test": "dotenv -e .env.test -- drizzle-kit migrate"
  },
  "dependencies": {
    "@alphacifer/drizzle": "^0.0.5",
    "@alphacifer/hono": "^0.0.6",
    "@domain/auth": "workspace:^",
    "@domain/core": "workspace:^",
    "@hono/node-server": "^2.0.1",
    "@node/drizzle": "workspace:^",
    "@node/hono": "workspace:^",
    "bcrypt": "^6.0.0",
    "hono": "^4.12.18",
    "jsonwebtoken": "^9.0.3",
    "nanoid": "^5.1.11",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "drizzle-kit": "^0.31.10"
  }
}
