{
  "name": "recsys",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "start": "node dist/src/index.js",
    "migrate": "tsx scripts/migrate.ts",
    "consume-events": "tsx scripts/consumer.ts",
    "worker": "tsx scripts/worker.ts",
    "seed": "tsx scripts/seed.ts",
    "bench:feed": "k6 run scripts/bench/k6-feed-load.js"
  },
  "dependencies": {
    "@fastify/swagger": "9.7.0",
    "@fastify/swagger-ui": "5.2.6",
    "@opentelemetry/api": "1.9.0",
    "bullmq": "5.35.1",
    "fastify": "5.2.1",
    "ioredis": "5.4.2",
    "neo4j-driver": "5.28.1",
    "pino": "9.5.0",
    "prom-client": "15.1.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "20.11.17",
    "tsx": "4.19.2",
    "typescript": "5.8.3",
    "vitest": "4.1.5"
  }
}
